# =============================================================================
# Noksha .gitignore: Strict Exclusion of Binaries and Build Outputs
# =============================================================================

# Build & Binary Directories
/bin/
bin/
/dist/
dist/

# Temporary & Object Artifacts
*.bin
*.tmp
*.log
*.o
*.a
*.so
.DS_Store
*.swp
*~

# Test & Debug Dumps
/tmp/
*.prof
*.flamegraph
